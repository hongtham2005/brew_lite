          "name": "TC-08: [Orders] Tạo đơn hàng mới có áp mã BREW10 & trừ kho (POST /orders)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Tạo đơn hàng thành công (201 Created)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "pm.test('Lưu orderId và orderTotal vào biến môi trường', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('PENDING');",
                  "    pm.expect(json).to.have.property('orderId');",
                  "    pm.collectionVariables.set('orderId', json.orderId);",
                  "    pm.collectionVariables.set('orderTotal', json.total);",
                  "    pm.collectionVariables.set('idempotencyKey', `idem-order-${json.orderId}-${Date.now()}`);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
