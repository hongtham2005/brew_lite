  "item": [
    {
      "name": "1. Functional & E2E Test Suite (TC-01 -> TC-13)",
      "description": "Kiểm thử toàn diện luồng nghiệp vụ End-to-End, Bảo mật JWT (401), Validate dữ liệu (400) và Idempotency.",
      "item": [
        {
          "name": "TC-01: [Health] Kiểm tra trạng thái API & Kết nối Database (GET /health)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP Status là 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Database ở trạng thái connected', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('ok');",
                  "    pm.expect(json.database).to.eql('connected');",
                  "});",
                  "pm.test('[NFR-01] Thời gian phản hồi < 500ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "TC-02: [Auth] Đăng ký tài khoản ngẫu nhiên mới (POST /auth/register)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const rand = Math.floor(100000 + Math.random() * 900000);",
                  "const uniqueEmail = `user_${Date.now()}_${rand}@brewlite.com`;",
                  "const uniqueName = `User ${rand}`;",
                  "pm.collectionVariables.set('testEmail', uniqueEmail);",
                  "pm.collectionVariables.set('testUsername', uniqueName);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Đăng ký thành công (200/201)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "pm.test('Trả về thông tin user và không lộ passwordHash', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.message).to.include('Đăng ký tài khoản thành công');",
                  "    pm.expect(json.user).to.have.property('email');",
                  "    pm.expect(json.user).to.not.have.property('passwordHash');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{testUsername}}\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "TC-03: [Auth] Đăng nhập và tự động lưu JWT Token (POST /auth/login)",
