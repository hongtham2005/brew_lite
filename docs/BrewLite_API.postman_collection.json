    {
      "name": "2. Performance & Mass Random Users Load Test (PERF-01 -> PERF-05)",
      "description": "Dùng với Postman Collection Runner (chỉnh Iterations = 20, 50, 100) hoặc Postman Performance Test (Virtual Users) để tạo hàng loạt Random Users & Đơn hàng ngẫu nhiên và đo thời gian phản hồi (< 500ms).",
      "item": [
        {
          "name": "PERF-01: [Mass User] Tự sinh Random User & Đăng ký (POST /auth/register)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const firstNames = ['Nguyen', 'Tran', 'Le', 'Pham', 'Hoang', 'Vo', 'Dang', 'Bui'];",
                  "const lastNames = ['Tuan', 'Tham', 'Phuong', 'Duy', 'Khoa', 'Nam', 'Minh', 'An', 'Linh'];",
                  "const fn = firstNames[Math.floor(Math.random() * firstNames.length)];",
                  "const ln = lastNames[Math.floor(Math.random() * lastNames.length)];",
                  "const rand = Math.floor(100000 + Math.random() * 900000);",
                  "const uniqueEmail = `${fn.toLowerCase()}.${ln.toLowerCase()}.${Date.now()}.${rand}@brewlite.com`;",
                  "const randomName = `${fn} ${ln} ${rand}`;",
                  "",
                  "const sizes = ['S', 'M', 'L'];",
                  "const toppings = ['Trân châu đen', 'Thạch dừa', 'Kem Cheese', 'Pudding Trứng', ''];",
                  "",
                  "pm.collectionVariables.set('testEmail', uniqueEmail);",
                  "pm.collectionVariables.set('testUsername', randomName);",
                  "pm.collectionVariables.set('randomProductId', String(Math.floor(Math.random() * 4) + 1));",
                  "pm.collectionVariables.set('randomSize', sizes[Math.floor(Math.random() * sizes.length)]);",
                  "pm.collectionVariables.set('randomTopping', toppings[Math.floor(Math.random() * toppings.length)]);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[PERF-01] Đăng ký Random User thành công (200/201)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "pm.test('[PERF-01] Thời gian băm bcrypt & tạo User < 800ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(800);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{testUsername}}\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "PERF-02: [Mass User] Đăng nhập & Lấy JWT Token (POST /auth/login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[PERF-02] Đăng nhập thành công & lấy JWT', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('accessToken', json.access_token);",
                  "});",
                  "pm.test('[PERF-02] Thời gian xác thực JWT < 500ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
